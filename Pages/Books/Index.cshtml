@page "/"
@model Colceriu_Alex_Lab2.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BookD.Books.First().Title)
            </th>
            <th>
                Author
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookD.Books.First().Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookD.Books.First().PublishingDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookD.Books.First().Publisher!.PublisherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookD.Books.First().BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BookD.Books) {
        string selectedRow = "";
        if (item.ID == Model.BookID)
        {
            selectedRow = "table-success";
        }
        <tr class="@selectedRow">
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Author!.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PublishingDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Publisher!.PublisherName)
            </td>
            <td>
                @{
                    if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            @category.Category.ID @: @category.Category.CategoryName <br />
                        }
                    }
                }
            </td>
            <td>
                <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (Model.BookD.Categories != null)
{
    <h3>Categories for Selected Book</h3>
    <table class="table">
        <tr>
            <th></th>
            <th>Category Name</th>
        </tr>
        @foreach (var item in Model.BookD.Categories)
        {
            string selectedRow = "";
            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @Html.ActionLink("Select", "Index", new { categoryID = item.ID })
                </td>
                <td>
                    @item.CategoryName
                </td>
            </tr>
        }
    </table>
}